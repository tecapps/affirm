{
  "dependencies": {
    "@nuxt/content": "^3.16.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.10",
    "@tailwindcss/vite": "^4.3.3",
    "@unhead/vue": "^3.4.2",
    "better-sqlite3": "^13.0.3",
    "daisyui": "^5.7.46",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "hash-wasm": "^4.12.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "why-is-node-running": "3.2.1"
  },
  "devDependencies": {
    "@catppuccin/daisyui": "^2.1.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.15",
    "@trunkio/launcher": "^1.3.4",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "nitro-cloudflare-dev": "^0.2.2",
    "nitropack": "^2.13.4",
    "node-gyp": "^13.0.2",
    "npm-run-all2": "^9.0.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  },
  "engines": {
    "node": "^26.10.0"
  },
  "name": "affirm",
  "private": true,
  "scripts": {
    "build": "aube exec nuxt build --envName=production",
    "build:staging": "aube exec nuxt build --envName=staging",
    "db:generate": "aube exec drizzle-kit generate",
    "db:migrate": "aube exec wrangler d1 migrations apply DB --local -c wrangler.dev.jsonc",
    "db:migrate:prod": "aube exec wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "db:migrate:staging": "aube exec wrangler d1 migrations apply DB --remote -c wrangler.staging.jsonc",
    "db:push:prod": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_PRODUCTION_DATABASE_ID aube exec rizzle-kit push",
    "db:push:staging": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_STAGING_DATABASE_ID aube exec drizzle-kit push",
    "db:studio:prod": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_PRODUCTION_DATABASE_ID aube exec drizzle-kit studio",
    "db:studio:staging": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_STAGING_DATABASE_ID aube exec drizzle-kit studio",
    "deploy": "aube exec run-s build deploy:wrangler",
    "deploy:snapshot": "aube exec run-s build:staging deploy:snapshot:wrangler",
    "deploy:snapshot:wrangler": "aube exec wrangler versions upload -c wrangler.staging.jsonc",
    "deploy:staging": "aube exec run-s build:staging deploy:staging:wrangler",
    "deploy:staging:wrangler": "aube exec wrangler deploy -c wrangler.staging.jsonc",
    "deploy:wrangler": "aube exec wrangler deploy -c wrangler.jsonc",
    "dev": "aube exec nuxt dev",
    "format": "aube exec run-s format:prettier format:trunk format:add",
    "format:add": "git add -A .",
    "format:prettier": "aube exec prettier --write .",
    "format:trunk": "aube exec trunk fmt -a",
    "generate": "aube exec nuxt generate",
    "lint": "aube exec run-s lint:eslint lint:trunk lint:types",
    "lint:eslint": "aube exec eslint .",
    "lint:eslint:fix": "aube exec eslint . --fix",
    "lint:fix": "aube exec run-s lint:eslint:fix lint:trunk:fix",
    "lint:trunk": "aube exec trunk check -a",
    "lint:trunk:fix": "aube exec trunk check -a --fix",
    "lint:types": "aube exec tsc --noEmit",
    "postinstall": "aube exec run-s postinstall:prepare types format",
    "postinstall:prepare": "aube exec nuxt prepare",
    "postinstall:trunk:install": "aube exec trunk install --ci",
    "postinstall:trunk:upgrade": "aube exec  trunk upgrade --ci",
    "preview": "aube exec run-s build preview:wrangler",
    "preview:wrangler": "aube exec wrangler dev",
    "test": "aube exec vitest",
    "test:coverage": "aube exec vitest --coverage",
    "test:e2e": "aube exec playwright test",
    "test:e2e:ui": "aube exec playwright test --ui",
    "test:nuxt": "aube exec vitest --project nuxt",
    "test:unit": "aube exec vitest --project unit",
    "test:watch": "aube exec vitest --watch",
    "types": "aube exec wrangler types"
  },
  "type": "module",
  "packageManager": "aube@2.2.17",
  "version": "0.0.0-dev.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.10.0",
      "onFail": "download"
    }
  },
  "aube": {
    "allowBuilds": {
      "unrs-resolver": true
    }
  }
}
