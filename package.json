{
  "author": {
    "email": "dave@dave.io",
    "name": "Dave Williams",
    "url": "https://github.com/daveio"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.2",
    "@nuxt/image": "^2.0.0",
    "@nuxt/scripts": "^1.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@unhead/vue": "^3.1.1",
    "better-sqlite3": "^12.10.0",
    "daisyui": "^5.5.20",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.1",
    "hash-wasm": "^4.12.0",
    "nuxt": "^4.4.6",
    "nuxt-auth-utils": "0.5.29",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@catppuccin/daisyui": "^2.1.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.11",
    "@nuxtjs/storybook": "^9.0.1",
    "@trunkio/launcher": "^1.3.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-storybook": "^10.4.1",
    "nitro-cloudflare-dev": "^0.2.2",
    "nitropack": "^2.13.4",
    "npm-run-all2": "^9.0.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "storybook": "^10.4.1",
    "vitest": "^4.1.8",
    "wrangler": "^4.96.0"
  },
  "engines": {
    "bun": "^1.3.14",
    "node": "^24.15.0"
  },
  "name": "affirm",
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "build": "bun run nuxt build --envName=production",
    "build:staging": "bun run nuxt build --envName=staging",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local -c wrangler.dev.jsonc",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote -c wrangler.staging.jsonc",
    "db:push:prod": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_PRODUCTION_DATABASE_ID drizzle-kit push",
    "db:push:staging": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_STAGING_DATABASE_ID drizzle-kit push",
    "db:studio:prod": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_PRODUCTION_DATABASE_ID drizzle-kit studio",
    "db:studio:staging": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_STAGING_DATABASE_ID drizzle-kit studio",
    "deploy": "bun run-s build deploy:wrangler",
    "deploy:snapshot": "bun run-s build:staging deploy:snapshot:wrangler",
    "deploy:snapshot:wrangler": "bun run wrangler versions upload -c wrangler.staging.jsonc",
    "deploy:staging": "bun run-s build:staging deploy:staging:wrangler",
    "deploy:staging:wrangler": "bun run wrangler deploy -c wrangler.staging.jsonc",
    "deploy:wrangler": "bun run wrangler deploy -c wrangler.jsonc",
    "dev": "bun run nuxt dev",
    "format": "bun run run-s format:prettier format:trunk format:add",
    "format:add": "git add -A .",
    "format:prettier": "bun run prettier --write .",
    "format:trunk": "bun run trunk fmt -a",
    "generate": "bun run nuxt generate",
    "lint": "bun run run-s lint:eslint lint:trunk lint:types",
    "lint:eslint": "bun run eslint .",
    "lint:eslint:fix": "bun run eslint . --fix",
    "lint:fix": "bun run run-s lint:eslint:fix lint:trunk:fix",
    "lint:trunk": "bun run trunk check -a",
    "lint:trunk:fix": "bun run trunk check -a --fix",
    "lint:types": "bun run tsc --noEmit",
    "postinstall": "bun run-s postinstall:prepare types format",
    "postinstall:prepare": "bun run nuxt prepare",
    "postinstall:trunk:install": "bun run trunk install --ci",
    "postinstall:trunk:upgrade": "bun run trunk upgrade --ci",
    "preview": "bun run-s build preview:wrangler",
    "preview:wrangler": "bun run wrangler dev",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:nuxt": "vitest --project nuxt",
    "test:unit": "vitest --project unit",
    "test:watch": "vitest --watch",
    "types": "bun run wrangler types",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "type": "module",
  "trustedDependencies": [
    "@parcel/watcher",
    "argon2",
    "better-sqlite3",
    "esbuild",
    "keytar",
    "node-pty",
    "protobufjs",
    "sharp",
    "tree-sitter-bash",
    "unrs-resolver",
    "workerd"
  ],
  "version": "0.0.0-dev.0"
}
