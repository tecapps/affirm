{
  "dependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.10",
    "@tailwindcss/vite": "^4.3.3",
    "@unhead/vue": "^3.4.1",
    "daisyui": "^5.7.46",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "hash-wasm": "^4.12.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@catppuccin/daisyui": "^2.1.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.15",
    "@playwright/test": "^1.63.0",
    "@trunkio/launcher": "^1.3.4",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "nitropack": "^2.13.4",
    "node-gyp": "^13.0.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.143.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "download",
      "version": "^26.10.0"
    }
  },
  "engines": {
    "node": "^26.10.0"
  },
  "name": "affirm",
  "packageManager": "pnpm@12.8.1",
  "private": true,
  "scripts": {
    "build": "pnpm exec nuxt build --envName=production",
    "build:staging": "pnpm exec nuxt build --envName=staging",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:migrate": "pnpm exec wrangler d1 migrations apply DB --local -c wrangler.dev.jsonc",
    "db:migrate:prod": "pnpm exec wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "db:migrate:staging": "pnpm exec wrangler d1 migrations apply DB --remote -c wrangler.staging.jsonc",
    "db:push:prod": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_PRODUCTION_DATABASE_ID pnpm exec drizzle-kit push",
    "db:push:staging": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_STAGING_DATABASE_ID pnpm exec drizzle-kit push",
    "db:studio:prod": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_PRODUCTION_DATABASE_ID pnpm exec drizzle-kit studio",
    "db:studio:staging": "CLOUDFLARE_DATABASE_ID=$CLOUDFLARE_STAGING_DATABASE_ID pnpm exec drizzle-kit studio",
    "deploy": "pnpm exec run-s build deploy:wrangler",
    "deploy:snapshot": "pnpm exec run-s build:staging deploy:snapshot:wrangler",
    "deploy:snapshot:wrangler": "pnpm exec wrangler versions upload -c wrangler.staging.jsonc",
    "deploy:staging": "pnpm exec run-s build:staging deploy:staging:wrangler",
    "deploy:staging:wrangler": "pnpm exec wrangler deploy -c wrangler.staging.jsonc",
    "deploy:wrangler": "pnpm exec wrangler deploy -c wrangler.jsonc",
    "dev": "pnpm exec nuxt dev",
    "format": "pnpm exec run-s format:prettier format:trunk",
    "format:prettier": "pnpm exec prettier --write .",
    "format:trunk": "pnpm exec trunk fmt -a",
    "generate": "pnpm exec nuxt generate",
    "lint": "pnpm exec run-s lint:eslint lint:trunk lint:types",
    "lint:eslint": "pnpm exec eslint .",
    "lint:eslint:fix": "pnpm exec eslint . --fix",
    "lint:fix": "pnpm exec run-s lint:eslint:fix lint:trunk:fix",
    "lint:trunk": "pnpm exec trunk check -a",
    "lint:trunk:fix": "pnpm exec trunk check -a --fix",
    "lint:types": "pnpm exec nuxt typecheck",
    "postinstall": "pnpm exec run-s postinstall:prepare types",
    "postinstall:prepare": "pnpm exec nuxt prepare",
    "postinstall:trunk:install": "pnpm exec trunk install --ci",
    "postinstall:trunk:upgrade": "pnpm exec trunk upgrade --ci",
    "preview": "pnpm exec run-s build preview:wrangler",
    "preview:wrangler": "pnpm exec wrangler dev",
    "test": "pnpm exec vitest",
    "test:coverage": "pnpm exec vitest --coverage",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:watch": "pnpm exec vitest --watch",
    "types": "pnpm exec wrangler types"
  },
  "type": "module",
  "version": "0.0.0-dev.0"
}
