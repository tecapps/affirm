{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "0d5d3a1ef1df71581f0d4ba61c3ea50f",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/",
  },
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],
  "images": {
    "binding": "IMAGES",
  },
  "keep_names": true,
  "logpush": false,
  "main": "./.output/server/index.mjs",
  "minify": false,
  "name": "affirm",
  // High limit so repeated local E2E runs don't trip the per-IP login throttle.
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 1000, "period": 60 },
    },
  ],
  "secrets": {
    "required": ["NUXT_SESSION_PASSWORD"],
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "local-dev",
      "database_name": "affirm-local",
      "migrations_dir": "server/database/migrations",
    },
  ],
}
